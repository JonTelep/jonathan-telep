user  www-data;
worker_processes  auto;

error_log  /var/log/nginx/error.log notice;
pid        /var/run/nginx.pid;

events {
    worker_connections  1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    access_log  /var/log/nginx/access.log  main;

    sendfile        on;
    keepalive_timeout  65;

    server {
        listen       3000;
        server_name  localhost;
        absolute_redirect off;

        # Static LLM / crawler files: never fall through to the SPA HTML.
        location ~ ^/(llms\.txt|llms-full\.txt|robots\.txt|about\.md|resume\.md)$ {
            root /usr/share/nginx/html;
            default_type text/plain;
            charset utf-8;
            try_files $uri =404;
        }

        location / {
            root   /usr/share/nginx/html;
            index  index.html;
            try_files $uri $uri/ /index.html;
        }

        location = /terminal {
            root   /usr/share/nginx/html;
            try_files /terminal.html =404;
        }

        location = /request {
            root   /usr/share/nginx/html;
            try_files /request.html =404;
        }

        location = /api/request {
            proxy_pass http://127.0.0.1:6006/api/request;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            client_max_body_size 20k;
        }

        location = /postgres { return 308 /postgres/$is_args$args; }

        location ^~ /postgres/api/ {
            proxy_pass http://127.0.0.1:6005/api/;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location ^~ /postgres/ {
            root /usr/share/nginx/html;
            try_files $uri $uri/ /postgres/index.html;
        }

        location = /jsonify { return 308 /jsonify/$is_args$args; }
        location = /json { return 308 /jsonify/$is_args$args; }
        location ~ ^/json/(.*)$ { return 308 /jsonify/$1$is_args$args; }

        location ^~ /jsonify/ {
            root /usr/share/nginx/html;
            try_files $uri $uri/ =404;
        }

        location ^~ /public/social/ {
            root /usr/share/nginx/html;
            try_files $uri =404;
            add_header Cache-Control "public, max-age=86400";
        }

        location = /api/space {
            proxy_pass https://ll.thespacedevs.com/2.3.0/launches/upcoming/?limit=5&mode=list;
            proxy_ssl_server_name on;
            proxy_set_header Host ll.thespacedevs.com;
            proxy_set_header Accept application/json;
        }

        location = /api/mrate {
            proxy_pass https://api.stlouisfed.org/fred/series/observations?series_id=MORTGAGE30US&api_key=${FRED_API_KEY}&file_type=json&sort_order=desc&limit=1;
            proxy_ssl_server_name on;
            proxy_set_header Host api.stlouisfed.org;
            proxy_set_header Accept application/json;
        }

        error_page   500 502 503 504  /50x.html;
        location = /50x.html {
            root   /usr/share/nginx/html;
        }
    }
}
