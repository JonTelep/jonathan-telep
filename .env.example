# Copy this file to .env and fill in local values. Coolify injects the same names at runtime.
# Do not commit real secrets.

# Optional: 30-year mortgage ticker on the landing page.
FRED_API_KEY=

# Inquiry form at /request — same Resend account / inbox as telep.io/contact.
# Copy these from the TelepIO Coolify service so both sites deliver to jon@telep.io.
#
# Required for Resend delivery (identical name to TelepIO):
RESEND_API_KEY=
#
# Optional. TelepIO default, reused here so the same verified Resend domain works:
# RESEND_FROM_EMAIL=TelepIO Contact <hello@contact.telep.io>
#
# Inbox is hardcoded to jon@telep.io (same as TelepIO /api/contact). Do not set a second mailbox.
#
# Optional fallback if RESEND_API_KEY is unset: server-side POST to the studio contact API
# (no browser CORS). Same inbox via TelepIO's Resend.
# TELEP_CONTACT_URL=https://telep.io/api/contact
#
# Tests only — do not set in production:
# RESEND_API_URL=http://127.0.0.1:9/emails
# INQUIRY_PORT=6006
